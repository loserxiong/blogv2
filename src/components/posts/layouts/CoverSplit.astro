---
import type { CollectionEntry } from 'astro:content'
import Prose from '~/components/posts/base/Prose.astro'
import PostHeading from '~/components/posts/base/PostHeading.astro'
import LqipImage from '~/components/base/LqipImage.astro'
interface Props {
  frontmatter: CollectionEntry<'posts'>['data']
  minutesRead?: string | number
  wordCount?: number
}
const { frontmatter, minutesRead, wordCount } = Astro.props
---

<article class="relative">
  <header class="px-6 sm:px-8 py-9 sm:py-12 border-b border-border/60">
    <div
      class:list={[
        'flex flex-col gap-7 sm:gap-8',
        frontmatter.cover && 'md:flex-row md:items-center',
        frontmatter.coverLayout === 'left' && 'md:flex-row-reverse',
      ]}
    >
      <div class="min-w-0 flex-1"><PostHeading {frontmatter} {minutesRead} {wordCount} /></div>
      {
        frontmatter.cover && (
          <div class="md:w-[34%] shrink-0">
            <LqipImage
              src={frontmatter.cover}
              alt={frontmatter.title}
              width={1200}
              height={630}
              loading="eager"
              decoding="async"
              format="webp"
              class="w-full aspect-[1.9] object-cover rounded-sm"
            />
          </div>
        )
      }
    </div>
  </header>
  <div class="px-6 sm:px-8 pt-9 sm:pt-10 pb-12">
    <Prose><slot /></Prose>
  </div>
</article>
