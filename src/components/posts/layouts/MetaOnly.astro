---
import type { CollectionEntry } from 'astro:content'
import Prose from '~/components/posts/base/Prose.astro'
import PostHeading from '~/components/posts/base/PostHeading.astro'
interface Props {
  frontmatter: CollectionEntry<'posts'>['data']
  minutesRead?: string | number
  wordCount?: number
}
const { frontmatter, minutesRead, wordCount } = Astro.props
---

<article class="relative">
  <header class="px-6 sm:px-8 py-9 sm:py-12 border-b border-border/60">
    <PostHeading {frontmatter} {minutesRead} {wordCount} />
  </header>
  <div class="px-6 sm:px-8 pt-9 sm:pt-10 pb-12"><Prose><slot /></Prose></div>
</article>
