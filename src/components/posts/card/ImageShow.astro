---
import LqipImage from '~/components/base/LqipImage.astro'
import { formatDate } from '~/lib/utils'
import { POSTS_CONFIG } from '~/config'
import Badge from '~/components/posts/base/Badge.astro'
import type { CardProps } from './List.astro'
interface Props extends CardProps {}
const { post, index, coverLayout, class: className, style } = Astro.props
const imagePosition = post.data.coverLayout || coverLayout || (index % 2 === 1 ? 'right' : 'left')
---

<article
  class:list={[
    'group flex flex-col gap-5 sm:gap-7 sm:flex-row border-b border-border/60 pb-8 last:border-0 last:pb-0',
    imagePosition === 'right' && 'sm:flex-row-reverse',
    className,
  ]}
  {style}
>
  {
    post.data.cover && (
      <a href={`/posts/${post.id}`} aria-label={`阅读：${post.data.title}`} class="sm:w-[32%] shrink-0 block overflow-hidden rounded-sm">
        <LqipImage
          src={post.data.cover}
          alt={post.data.title}
          width={1200}
          height={630}
          loading="lazy"
          decoding="async"
          format="webp"
          class="w-full aspect-[1.9] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </a>
    )
  }
  <div class="min-w-0 flex-1">
    <a href={`/posts/${post.id}`} class="group/title block">
      <h2 class="post-list-title group-hover/title:text-[var(--color-highlight)] transition-colors">{post.data.title}</h2>
      {post.data.description && <p class="mt-2 text-[15px] leading-7 text-muted-foreground line-clamp-3">{post.data.description}</p>}
    </a>
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted-foreground">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {
        post.data.updatedDate && (
          <span>
            更新于 <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
          </span>
        )
      }
      {post.data.recommend && <Badge type="recommend" content={POSTS_CONFIG.recommendText} />}
      {post.data.tags?.map((tag) => <Badge type="tag" content={tag} />)}
    </div>
  </div>
</article>
