---
import { Image } from 'astro:assets'
import type { PhotoData } from '~/types'

interface Props {
  albums: PhotoData[]
  perAlbum: number
}

const { albums, perAlbum } = Astro.props
---

<div class="space-y-8">
  {
    albums.map((album) => (
      <a href="/photos" class="group block">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="font-semibold tracking-tight group-hover:text-[var(--color-highlight)] transition-colors">
            <span class="mr-1.5" aria-hidden="true">
              {album.icon.value}
            </span>
            {album.title}
          </h3>
          <span class="shrink-0 text-xs text-muted-foreground">{album.date}</span>
        </div>
        {album.description && <p class="mt-1 text-sm text-muted-foreground">{album.description}</p>}
        <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
          {album.photos.slice(0, perAlbum).map((photo) => (
            <div class="aspect-square overflow-hidden rounded-md bg-muted/40">
              <Image
                src={photo.src as ImageMetadata}
                alt={photo.alt}
                widths={[240, 480]}
                sizes="(min-width: 640px) 160px, 45vw"
                format="webp"
                quality={70}
                class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </a>
    ))
  }
</div>
