---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  background?: boolean
  [key: string]: any
}

const { href, class: className, background, ...props }: Props = Astro.props
const isActive = href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href)
---

<a
  {href}
  class={cn(
    'text-sm px-2 sm:px-4 py-2 font-medium',
    background && 'transition-colors text-muted-foreground hover:text-[var(--color-highlight)]',
    isActive && 'text-[var(--color-highlight)]',
    className
  )}
  aria-current={isActive ? 'page' : undefined}
  rel="prefetch"
  {...props}
>
  <slot />
</a>
