---
import { PROJECTS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { Image } from 'astro:assets'
import { getAllProjects, projectSlug } from '~/lib/data'
import PageTitle from '~/components/base/PageTitle.astro'

const { title, description, introduce } = PROJECTS_CONFIG
const projects = await getAllProjects()
---

<Layout {title} {description}>
  <div class="relative z-[1] px-6 sm:px-8 pt-10 pb-12">
    <PageTitle {title} {introduce} />
    <div class="mt-10 space-y-10">
      {
        projects.map((entry) => {
          const project = entry.data
          const href = `/projects/${projectSlug(entry)}/`
          return (
            <article class="pb-10 border-b border-border/60 last:border-0 last:pb-0">
              <a
                href={href}
                aria-label={`查看 ${project.name}`}
                class="project-preview group block overflow-hidden rounded-md border border-border/60 bg-muted/25"
              >
                {project.preview ? (
                  <Image
                    src={project.preview}
                    alt={project.previewAlt || `${project.name} 作品展示`}
                    width={Math.min(project.preview.width, 1600)}
                    quality={95}
                    style={{ maxWidth: `${project.preview.width / 2}px`, marginInline: 'auto' }}
                    class="w-full h-auto object-contain p-4 sm:p-6 transition-transform duration-300 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                ) : (
                  <div class="aspect-[1.9] flex flex-col items-center justify-center gap-4 bg-[radial-gradient(ellipse_at_center,var(--color-accent),transparent_75%)]">
                    {project.icon && (
                      <Image
                        src={project.icon}
                        alt=""
                        width={96}
                        height={96}
                        densities={[1, 2, 3]}
                        format="png"
                        class="size-16 sm:size-20 object-contain"
                        loading="lazy"
                      />
                    )}
                    <span class="font-serif text-2xl sm:text-3xl tracking-tight">{project.name}</span>
                  </div>
                )}
              </a>
              <div class="mt-5 flex items-start justify-between gap-4">
                <h2 class="post-list-title">
                  <a href={href} class="hover:text-[var(--color-highlight)] transition-colors">
                    {project.name}
                  </a>
                </h2>
                {project.icon && (
                  <Image
                    src={project.icon}
                    alt=""
                    width={32}
                    height={32}
                    densities={[1, 2, 3]}
                    format="png"
                    class="size-8 object-contain shrink-0"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="mt-2 text-base leading-7 text-muted-foreground max-w-prose">{project.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-5 text-sm">
                <a href={href} class="inline-flex items-center gap-1.5 text-[var(--color-highlight)] hover:underline underline-offset-4">
                  了解项目
                  <span class="icon-[ph--arrow-right] size-4" aria-hidden="true" />
                </a>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</Layout>
