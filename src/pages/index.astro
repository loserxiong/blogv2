---
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS } from '~/config.ts'
import { GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import HomeProjects from '~/components/home/HomeProjects.astro'
import HomePhotos from '~/components/home/HomePhotos.astro'
import { getHomeProjects, getNumPosts, getPinnedPosts } from '~/lib/data'
import { getHomePhotos } from '~/lib/photos'
import homeSettings from '~/data/home.json'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

let showPosts = []
const pinnedPosts = await getPinnedPosts()
const hasPinnedPosts = pinnedPosts.length > 0
if (hasPinnedPosts) {
  showPosts = pinnedPosts
} else {
  showPosts = await getNumPosts(size)
}

// 首页模块由 CMS「首页设置」控制：列表里的模块按顺序显示
const knownSections = ['posts', 'projects', 'photos'] as const
type Section = (typeof knownSections)[number]
const toCount = (value: unknown, fallback: number) => {
  const count = Number(value)
  return Number.isInteger(count) && count > 0 ? count : fallback
}
const sections = [...new Set(Array.isArray(homeSettings.sections) ? homeSettings.sections : ['posts'])].filter(
  (section): section is Section => (knownSections as readonly string[]).includes(section)
)
const homeProjects = sections.includes('projects') ? await getHomeProjects(toCount(homeSettings.projectsLimit, 3)) : []
const homePhotos = sections.includes('photos') ? await getHomePhotos(toCount(homeSettings.photosLimit, 2)) : []
const photosPerAlbum = toCount(homeSettings.photosPerAlbum, 4)
---

<Layout title="首页" description={SITE.description}>
  <div class="relative z-[1]">
    <div class="px-6 sm:px-8 pt-8 sm:pt-10 pb-8 sm:pb-9">
      <h1 class="text-[2.125rem] sm:text-[2.375rem] leading-tight tracking-tight">
        Jaason Xiong<span class="text-[var(--color-highlight)]">.</span>
      </h1>
      <p class="mt-2 text-sm text-muted-foreground tracking-wide">
        产品经理 <span class="px-1.5 text-border">/</span> 跑者 <span class="px-1.5 text-border">/</span> 装备控
      </p>
      <p class="mt-6 text-lg font-medium leading-relaxed tracking-tight">
        配速可以普通，<br class="sm:hidden" />装备不能普通<span class="ml-1.5 text-lg" aria-hidden="true">🍌</span>
      </p>
      <div class="mt-2 text-sm leading-6 text-muted-foreground">
        <p>运动行业软件产品经理</p>
        <p>Tech &amp; running enthusiast</p>
      </div>
      <div class="mt-5 flex items-center gap-5">
        {
          SOCIAL_LINKS.map((item) => (
            <SocialLink
              href={item.url}
              icon={item.icon}
              name={item.name === 'rednote' ? '小红书' : 'Strava'}
              aria-label={item.name === 'rednote' ? '在小红书关注我' : '在 Strava 关注我'}
              count={item.count}
              label="followers"
            />
          ))
        }
      </div>
    </div>
    {
      ENABLED && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl">Spotlight</h2>
              <p class="text-muted-foreground mb-6 mt-1">GitHub contributions in the past year:</p>
            </div>
            <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:load transition:animate="none" />
          </div>
        </>
      )
    }
    {
      SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
        <>
          <SectionDivider />
          <div class="py-8 pb-10 px-6 max-md:px-6">
            <div class="px-2 max-md:px-0">
              <h2 class="text-2xl sm:text-3xl tracking-tight">Skills</h2>
              <p class="text-muted-foreground mb-6 mt-1">It's not just skills, but also tools:</p>
            </div>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </>
      )
    }
    {
      sections.map((section) => (
        <>
          {section === 'posts' && (
            <>
              <SectionDivider />
              <div class="py-6 pb-8 px-6 sm:px-8">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="text-2xl tracking-tight">Posts</h2>
                  <a href="/posts" class="text-sm text-muted-foreground hover:text-[var(--color-highlight)] flex items-center gap-2">
                    全部文章 <span aria-hidden="true" class="icon-[ph--arrow-up-right] size-4" />
                  </a>
                </div>
                <p class="text-muted-foreground text-sm mb-6 mt-1.5">记录下最近的输出和思考</p>
                <List posts={showPosts} {type} coverLayout={POSTS_CONFIG.homePageConfig?.coverLayout} />
              </div>
            </>
          )}
          {section === 'projects' && homeProjects.length > 0 && (
            <>
              <SectionDivider />
              <div class="py-6 pb-8 px-6 sm:px-8">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="text-2xl tracking-tight">Projects</h2>
                  <a href="/projects" class="text-sm text-muted-foreground hover:text-[var(--color-highlight)] flex items-center gap-2">
                    全部项目 <span aria-hidden="true" class="icon-[ph--arrow-up-right] size-4" />
                  </a>
                </div>
                <p class="text-muted-foreground text-sm mb-2 mt-1.5">业余时间做的小工具</p>
                <HomeProjects projects={homeProjects} />
              </div>
            </>
          )}
          {section === 'photos' && homePhotos.length > 0 && (
            <>
              <SectionDivider />
              <div class="py-6 pb-8 px-6 sm:px-8">
                <div class="flex items-center justify-between gap-4">
                  <h2 class="text-2xl tracking-tight">Photos</h2>
                  <a href="/photos" class="text-sm text-muted-foreground hover:text-[var(--color-highlight)] flex items-center gap-2">
                    全部照片 <span aria-hidden="true" class="icon-[ph--arrow-up-right] size-4" />
                  </a>
                </div>
                <p class="text-muted-foreground text-sm mb-6 mt-1.5">路上和赛道上的瞬间</p>
                <HomePhotos albums={homePhotos} perAlbum={photosPerAlbum} />
              </div>
            </>
          )}
        </>
      ))
    }
  </div>
</Layout>
