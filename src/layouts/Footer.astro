---
import { FOOTER_LINKS } from '~/config'
import FooterLink from '~/components/base/FooterLink.astro'
---

<footer class="global-layout-width mx-auto w-full border-t border-x border-border/50 px-6 sm:px-8 pt-7 pb-10">
  <nav aria-label="页脚导航" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
    {FOOTER_LINKS.map((link) => <FooterLink href={link.url}>{link.name}</FooterLink>)}
  </nav>
  <p class="mt-6 text-xs text-muted-foreground">© {new Date().getFullYear()} Jaason Xiong</p>
</footer>
